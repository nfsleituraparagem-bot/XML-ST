<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consolidador NF-e por NCM</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#0284c7',
                            600: '#0369a1',
                            700: '#075985',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        /* Custom scrollbar for better look */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="min-h-screen bg-slate-50 text-slate-800 pb-16">

    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-xl shadow-md shadow-blue-500/20">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold text-slate-900 leading-tight">Consolidador de NF-e</h1>
                    <p class="text-xs text-slate-500">Agrupamento NCM & Filtros com Cálculo de ST</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div id="file-counter" class="hidden text-xs font-semibold px-3 py-1.5 bg-blue-50 text-blue-700 rounded-full border border-blue-200 flex items-center gap-2">
                    <i class="fa-solid fa-file-code"></i> <span id="file-counter-text">0 nota(s)</span>
                </div>
                <button id="reset-btn" class="hidden text-xs text-rose-600 hover:text-rose-800 font-semibold px-3 py-1.5 rounded-lg border border-rose-200 hover:bg-rose-50 transition-colors flex items-center gap-1.5">
                    <i class="fa-solid fa-trash"></i> Limpar Tudo
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6 space-y-6">

        <section id="upload-section">
            <div id="drop-zone" class="border-2 border-dashed border-slate-300 hover:border-blue-500 transition-all bg-white rounded-2xl p-6 text-center cursor-pointer shadow-sm relative overflow-hidden group">
                <input type="file" id="xml-input" accept=".xml" multiple class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10" />
                <div class="space-y-2 pointer-events-none">
                    <div class="w-12 h-12 mx-auto rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-xl group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-slate-700">Clique para selecionar ou arraste arquivos XML aqui</p>
                        <p class="text-xs text-slate-400 mt-0.5">Carregue um ou múltiplos XMLs para consolidar e filtrar conjuntamente</p>
                    </div>
                </div>
            </div>
        </section>

        <section id="filter-section" class="hidden">
            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-filter text-blue-600 text-sm"></i>
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-600">Filtros de Pesquisa e Período</h2>
                    </div>
                    <button id="clear-filters-btn" class="text-xs text-blue-600 hover:text-blue-800 font-medium hover:underline flex items-center gap-1">
                        <i class="fa-solid fa-arrow-rotate-left text-[10px]"></i> Limpar Filtros
                    </button>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                    <!-- Date Range De -->
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Data Emissão (De):</label>
                        <input type="date" id="filter-date-from" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-medium text-slate-700 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                    </div>

                    <!-- Date Range Até -->
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Data Emissão (Até):</label>
                        <input type="date" id="filter-date-to" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-medium text-slate-700 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                    </div>

                    <!-- Município / UF Filter -->
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Município / UF:</label>
                        <select id="filter-city" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-medium text-slate-700 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                            <option value="">Todos os Municípios</option>
                        </select>
                    </div>

                    <!-- Supplier / NF Search -->
                    <div>
                        <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Fornecedor / Nº NF / CNPJ:</label>
                        <div class="relative">
                            <input type="text" id="filter-search" placeholder="Buscar por fornecedor, NF..." class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-8 pr-3 py-2 text-xs font-medium text-slate-700 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                            <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-2.5 text-slate-400 text-xs pointer-events-none"></i>
                        </div>
                    </div>

                    <!-- NCM Search -->
                    <div class="lg:col-span-4">
                        <label class="block text-[11px] font-semibold text-slate-500 uppercase tracking-wider mb-1">Filtrar por NCM específico:</label>
                        <div class="relative">
                            <input type="text" id="filter-ncm" placeholder="Ex: 48239099 ou parte do NCM..." class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-8 pr-3 py-2 text-xs font-medium text-slate-700 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all">
                            <i class="fa-solid fa-barcode absolute left-2.5 top-2.5 text-slate-400 text-xs pointer-events-none"></i>
                        </div>
                    </div>
                </div>

                <!-- Active Filter Stats Bar -->
                <div id="filter-status-bar" class="flex flex-wrap items-center justify-between text-xs text-slate-500 pt-2 border-t border-slate-100 gap-2">
                    <span id="filter-matches-text">Exibindo dados de <strong class="text-slate-800">0</strong> nota(s) fiscal(is).</span>
                    <span id="active-filter-tags" class="flex flex-wrap gap-1.5"></span>
                </div>
            </div>
        </section>

        <section id="header-section" class="hidden space-y-6">
            
            <!-- Overall Consolidated Tax Card -->
            <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm">
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-4 flex items-center justify-between">
                    <span class="flex items-center gap-2">
                        <i class="fa-solid fa-calculator text-blue-600"></i> Totais do Período / Filtro Selecionado
                    </span>
                    <span class="text-[11px] text-slate-400 font-normal normal-case">Somatório automático das notas filtradas</span>
                </h3>
                <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3 text-center">
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                        <span class="text-[10px] font-semibold text-slate-400 uppercase block">BC ICMS</span>
                        <span class="text-sm font-bold text-slate-700 mt-1 block" id="tot-bc-icms">R$ 0,00</span>
                    </div>
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                        <span class="text-[10px] font-semibold text-slate-400 uppercase block">Valor ICMS</span>
                        <span class="text-sm font-bold text-slate-700 mt-1 block" id="tot-v-icms">R$ 0,00</span>
                    </div>
                    <div class="p-3 bg-blue-50/50 rounded-xl border border-blue-100">
                        <span class="text-[10px] font-semibold text-blue-600 uppercase block">BC ICMS ST</span>
                        <span class="text-sm font-bold text-blue-900 mt-1 block" id="tot-bc-st">R$ 0,00</span>
                    </div>
                    <div class="p-3 bg-blue-50/50 rounded-xl border border-blue-100">
                        <span class="text-[10px] font-semibold text-blue-600 uppercase block">Valor ICMS ST</span>
                        <span class="text-sm font-bold text-blue-900 mt-1 block" id="tot-v-st">R$ 0,00</span>
                    </div>
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                        <span class="text-[10px] font-semibold text-slate-400 uppercase block">Valor IPI Total</span>
                        <span class="text-sm font-bold text-slate-700 mt-1 block" id="tot-v-ipi">R$ 0,00</span>
                    </div>
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-100">
                        <span class="text-[10px] font-semibold text-slate-400 uppercase block">Total Produtos</span>
                        <span class="text-sm font-bold text-slate-700 mt-1 block" id="tot-v-prod">R$ 0,00</span>
                    </div>
                    <div class="p-3 bg-emerald-50 rounded-xl border border-emerald-100 col-span-2 md:col-span-4 lg:col-span-1">
                        <span class="text-[10px] font-semibold text-emerald-600 uppercase block">Total Notas</span>
                        <span class="text-sm font-bold text-emerald-800 mt-1 block" id="tot-v-nf">R$ 0,00</span>
                    </div>
                </div>
            </div>

            <!-- List of filtered NF-es (accordion/dropdown view) -->
            <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
                <details class="group">
                    <summary class="flex items-center justify-between cursor-pointer list-none font-semibold text-xs text-slate-700 uppercase tracking-wider">
                        <span class="flex items-center gap-2">
                            <i class="fa-solid fa-receipt text-blue-600"></i>
                            Notas Fiscais Incluídas no Filtro (<span id="invoice-list-count">0</span>)
                        </span>
                        <i class="fa-solid fa-chevron-down text-slate-400 group-open:rotate-180 transition-transform"></i>
                    </summary>
                    <div class="mt-4 pt-3 border-t border-slate-100 max-h-60 overflow-y-auto">
                        <table class="w-full text-left text-xs">
                            <thead>
                                <tr class="text-slate-400 border-b border-slate-100 pb-1">
                                    <th class="py-1 px-2">NF / Série</th>
                                    <th class="py-1 px-2">Data Emissão</th>
                                    <th class="py-1 px-2">Fornecedor / Município</th>
                                    <th class="py-1 px-2 text-right">Valor Total</th>
                                </tr>
                            </thead>
                            <tbody id="invoice-list-table-body" class="divide-y divide-slate-100">
                                <!-- Injected via JS -->
                            </tbody>
                        </table>
                    </div>
                </details>
            </div>

        </section>

        <section id="ncm-table-section" class="hidden">
            <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
                <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">Consolidado por NCM</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Soma de Valor Total dos Produtos e Valor do IPI agrupados por código NCM</p>
                    </div>
                    <div class="text-xs text-slate-400 flex items-center gap-2">
                        <i class="fa-solid fa-circle-info text-blue-500"></i> Clique na seta para expandir os itens
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50/80 border-b border-slate-200/80 text-[13px] font-medium text-slate-500">
                                <th class="py-3.5 px-4 w-12 text-center"></th>
                                <th class="py-3.5 px-4">NCM</th>
                                <th class="py-3.5 px-4 text-right">Valor Total dos Produtos</th>
                                <th class="py-3.5 px-4 text-center">Alíq. ICMS Média/Ref.</th>
                                <th class="py-3.5 px-4 text-right">Valor Total IPI (VL. IPI Somado)</th>
                            </tr>
                        </thead>
                        <tbody id="ncm-table-body" class="divide-y divide-slate-100 text-sm">
                            <!-- Rows injected via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <div id="empty-state" class="text-center py-12 bg-white rounded-2xl border border-slate-200 shadow-sm">
            <i class="fa-solid fa-file-code text-4xl text-slate-300 mb-3"></i>
            <p class="text-slate-600 font-medium">Nenhum arquivo XML carregado no momento.</p>
            <p class="text-xs text-slate-400 mt-1">Carregue um ou múltiplos arquivos de NF-e no campo acima para começar.</p>
        </div>

        <div id="no-results-state" class="hidden text-center py-12 bg-white rounded-2xl border border-slate-200 shadow-sm">
            <i class="fa-solid fa-filter-circle-xmark text-4xl text-amber-400 mb-3"></i>
            <p class="text-slate-700 font-medium">Nenhuma nota ou produto corresponde aos filtros aplicados.</p>
            <p class="text-xs text-slate-400 mt-1">Tente ajustar o período de datas, município ou o termo de busca.</p>
            <button id="no-results-clear-btn" class="mt-4 text-xs font-semibold px-4 py-2 bg-blue-50 text-blue-700 rounded-xl hover:bg-blue-100 transition-colors">
                Limpar Todos os Filtros
            </button>
        </div>

    </main>

    <script>
        // Global State storing parsed XML records and read NCMs
        let invoicesData = [];
        let readNcms = new Set();

        function formatBRL(value) {
            return new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(value || 0);
        }

        function formatPercent(value) {
            if (value === null || value === undefined || isNaN(value)) return '0%';
            return `${Number(value).toLocaleString('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 2 })}%`;
        }

        function getXmlText(parent, selector) {
            if (!parent) return '';
            const node = parent.querySelector(selector);
            return node ? node.textContent.trim() : '';
        }

        function getXmlFloat(parent, selector) {
            const txt = getXmlText(parent, selector);
            return txt ? parseFloat(txt) : 0;
        }

        document.addEventListener('DOMContentLoaded', () => {
            const dropZone = document.getElementById('drop-zone');
            const xmlInput = document.getElementById('xml-input');
            const resetBtn = document.getElementById('reset-btn');
            const clearFiltersBtn = document.getElementById('clear-filters-btn');
            const noResultsClearBtn = document.getElementById('no-results-clear-btn');

            // Filter inputs
            const filterDateFrom = document.getElementById('filter-date-from');
            const filterDateTo = document.getElementById('filter-date-to');
            const filterCity = document.getElementById('filter-city');
            const filterSearch = document.getElementById('filter-search');
            const filterNcm = document.getElementById('filter-ncm');

            xmlInput.addEventListener('change', (e) => handleFiles(e.target.files));

            dropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropZone.classList.add('border-blue-500', 'bg-blue-50/20');
            });

            dropZone.addEventListener('dragleave', () => {
                dropZone.classList.remove('border-blue-500', 'bg-blue-50/20');
            });

            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('border-blue-500', 'bg-blue-50/20');
                if (e.dataTransfer.files.length) {
                    handleFiles(e.dataTransfer.files);
                }
            });

            // Live Filtering listeners
            const filterInputs = [filterDateFrom, filterDateTo, filterCity, filterSearch, filterNcm];
            filterInputs.forEach(input => {
                input.addEventListener('input', updateDashboard);
                input.addEventListener('change', updateDashboard);
            });

            clearFiltersBtn.addEventListener('click', clearAllFilters);
            noResultsClearBtn.addEventListener('click', clearAllFilters);

            resetBtn.addEventListener('click', () => {
                invoicesData = [];
                readNcms.clear();
                xmlInput.value = '';
                clearAllFilters();
                updateUIState();
            });
        });

        function clearAllFilters() {
            document.getElementById('filter-date-from').value = '';
            document.getElementById('filter-date-to').value = '';
            document.getElementById('filter-city').value = '';
            document.getElementById('filter-search').value = '';
            document.getElementById('filter-ncm').value = '';
            updateDashboard();
        }

        function handleFiles(files) {
            const fileList = Array.from(files).filter(file => file.name.toLowerCase().endsWith('.xml') || file.type === 'text/xml');
            
            if (fileList.length === 0) {
                alert('Por favor, selecione arquivos em formato XML válidos.');
                return;
            }

            let loadedCount = 0;
            fileList.forEach(file => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    try {
                        const parser = new DOMParser();
                        const xmlDoc = parser.parseFromString(e.target.result, "text/xml");
                        
                        const parsedInvoice = parseNFeXML(xmlDoc, file.name);
                        if (parsedInvoice) {
                            const exists = invoicesData.some(inv => inv.chave && inv.chave === parsedInvoice.chave);
                            if (!exists) {
                                invoicesData.push(parsedInvoice);
                            }
                        }
                    } catch (err) {
                        console.error("Erro ao ler XML:", file.name, err);
                    } finally {
                        loadedCount++;
                        if (loadedCount === fileList.length) {
                            populateCityDropdown();
                            updateUIState();
                            updateDashboard();
                        }
                    }
                };
                reader.readAsText(file);
            });
        }

        function parseNFeXML(xmlDoc, fileName) {
            const infNFe = xmlDoc.querySelector('infNFe');
            if (!infNFe) return null;

            const ide = xmlDoc.querySelector('ide');
            const emit = xmlDoc.querySelector('emit');
            const enderEmit = emit ? emit.querySelector('enderEmit') : null;
            const total = xmlDoc.querySelector('total > ICMSTot');
            
            let key = infNFe.getAttribute('Id') || '';
            key = key.replace(/^NFe/, '');
            if (!key) {
                key = getXmlText(xmlDoc, 'chNFe');
            }

            const fornecedor = getXmlText(emit, 'xNome') || 'Não identificado';
            const cnpj = getXmlText(emit, 'CNPJ') || getXmlText(emit, 'CPF');
            const municipio = getXmlText(enderEmit, 'xMun');
            const uf = getXmlText(enderEmit, 'UF');
            const endereco = `${municipio ? municipio : ''}${municipio && uf ? ' - ' : ''}${uf ? uf : ''}`;

            let dhEmiRaw = getXmlText(ide, 'dhEmi') || getXmlText(ide, 'dEmi');
            let dhEmiFormatted = '-';
            let isoDate = '';

            if (dhEmiRaw) {
                try {
                    const dateObj = new Date(dhEmiRaw);
                    if (!isNaN(dateObj.getTime())) {
                        dhEmiFormatted = dateObj.toLocaleDateString('pt-BR');
                        isoDate = dateObj.toISOString().split('T')[0];
                    }
                } catch (e) {}
            }

            const totals = {
                vBC: getXmlFloat(total, 'vBC'),
                vICMS: getXmlFloat(total, 'vICMS'),
                vBCST: getXmlFloat(total, 'vBCST'),
                vST: getXmlFloat(total, 'vST'),
                vIPI: getXmlFloat(total, 'vIPI'),
                vProd: getXmlFloat(total, 'vProd'),
                vNF: getXmlFloat(total, 'vNF')
            };

            const items = [];
            const detNodes = xmlDoc.querySelectorAll('det');

            detNodes.forEach(det => {
                const prod = det.querySelector('prod');
                const icmsNode = det.querySelector('imposto > ICMS');
                const ipiNode = det.querySelector('imposto > IPI');

                if (!prod) return;

                const cProd = getXmlText(prod, 'cProd');
                const xProd = getXmlText(prod, 'xProd');
                const ncm = getXmlText(prod, 'NCM') || 'Outros';
                const qCom = getXmlFloat(prod, 'qCom');
                const uCom = getXmlText(prod, 'uCom');
                const vProd = getXmlFloat(prod, 'vProd');

                let pICMS = 0;
                if (icmsNode) {
                    const pIcmsText = icmsNode.querySelector('pICMS');
                    if (pIcmsText) {
                        pICMS = parseFloat(pIcmsText.textContent) || 0;
                    }
                }

                let pIPI = 0;
                let vIPI = 0;
                if (ipiNode) {
                    const pIpiText = ipiNode.querySelector('pIPI');
                    const vIpiText = ipiNode.querySelector('vIPI');
                    if (pIpiText) pIPI = parseFloat(pIpiText.textContent) || 0;
                    if (vIpiText) vIPI = parseFloat(vIpiText.textContent) || 0;
                }

                items.push({
                    cProd,
                    xProd,
                    ncm,
                    qCom,
                    uCom,
                    vProd,
                    pICMS,
                    pIPI,
                    vIPI,
                    nNF: getXmlText(ide, 'nNF'),
                    fornecedor
                });
            });

            return {
                fileName,
                nNF: getXmlText(ide, 'nNF'),
                serie: getXmlText(ide, 'serie'),
                chave: key,
                dhEmi: dhEmiFormatted,
                isoDate: isoDate,
                fornecedor,
                cnpj,
                municipio,
                uf,
                endereco,
                totals,
                items
            };
        }

        function populateCityDropdown() {
            const citySelect = document.getElementById('filter-city');
            const currentVal = citySelect.value;
            citySelect.innerHTML = '<option value="">Todos os Municípios</option>';

            const citiesSet = new Set();
            invoicesData.forEach(inv => {
                if (inv.endereco) {
                    citiesSet.add(inv.endereco);
                }
            });

            Array.from(citiesSet).sort().forEach(city => {
                const opt = document.createElement('option');
                opt.value = city;
                opt.textContent = city;
                citySelect.appendChild(opt);
            });

            citySelect.value = currentVal;
        }

        function updateUIState() {
            const hasData = invoicesData.length > 0;
            
            document.getElementById('empty-state').classList.toggle('hidden', hasData);
            document.getElementById('filter-section').classList.toggle('hidden', !hasData);
            document.getElementById('header-section').classList.toggle('hidden', !hasData);
            document.getElementById('ncm-table-section').classList.toggle('hidden', !hasData);
            document.getElementById('reset-btn').classList.toggle('hidden', !hasData);
            
            const counter = document.getElementById('file-counter');
            if (hasData) {
                counter.classList.remove('hidden');
                document.getElementById('file-counter-text').textContent = `${invoicesData.length} nota(s) carregada(s)`;
            } else {
                counter.classList.add('hidden');
            }
        }

        function updateDashboard() {
            if (invoicesData.length === 0) return;

            const dateFrom = document.getElementById('filter-date-from').value;
            const dateTo = document.getElementById('filter-date-to').value;
            const selectedCity = document.getElementById('filter-city').value.toLowerCase();
            const searchVal = document.getElementById('filter-search').value.toLowerCase().trim();
            const ncmVal = document.getElementById('filter-ncm').value.replaceAll('.', '').trim();

            // 1. Filter Invoices
            const filteredInvoices = invoicesData.filter(inv => {
                if (dateFrom && inv.isoDate && inv.isoDate < dateFrom) return false;
                if (dateTo && inv.isoDate && inv.isoDate > dateTo) return false;
                if (selectedCity && (!inv.endereco || !inv.endereco.toLowerCase().includes(selectedCity))) return false;

                if (searchVal) {
                    const matchForn = inv.fornecedor.toLowerCase().includes(searchVal);
                    const matchNF = inv.nNF.toLowerCase().includes(searchVal);
                    const matchCnpj = inv.cnpj && inv.cnpj.toLowerCase().includes(searchVal);
                    if (!matchForn && !matchNF && !matchCnpj) return false;
                }

                return true;
            });

            // 2. Aggregate Totals and Group Items by NCM
            const consolidatedTotals = {
                vBC: 0, vICMS: 0, vBCST: 0, vST: 0, vIPI: 0, vProd: 0, vNF: 0
            };

            filteredInvoices.forEach(inv => {
                consolidatedTotals.vBC += inv.totals.vBC;
                consolidatedTotals.vICMS += inv.totals.vICMS;
                consolidatedTotals.vBCST += inv.totals.vBCST;
                consolidatedTotals.vST += inv.totals.vST;
                consolidatedTotals.vIPI += inv.totals.vIPI;
                consolidatedTotals.vProd += inv.totals.vProd;
                consolidatedTotals.vNF += inv.totals.vNF;
            });

            const ncmGroups = {};
            let totalMatchingItemsCount = 0;

            filteredInvoices.forEach(inv => {
                inv.items.forEach(item => {
                    const cleanNCM = item.ncm.replaceAll('.', '');
                    if (ncmVal && !cleanNCM.includes(ncmVal)) {
                        return;
                    }

                    totalMatchingItemsCount++;

                    if (!ncmGroups[item.ncm]) {
                        ncmGroups[item.ncm] = {
                            ncm: item.ncm,
                            totalValue: 0,
                            totalIpiValue: 0,
                            icmsRatesSet: new Set(),
                            items: []
                        };
                    }

                    const group = ncmGroups[item.ncm];
                    group.totalValue += item.vProd;
                    group.totalIpiValue += item.vIPI;
                    group.icmsRatesSet.add(item.pICMS);
                    group.items.push(item);
                });
            });

            const ncmGroupList = Object.values(ncmGroups);

            // Update top totals display
            document.getElementById('tot-bc-icms').textContent = formatBRL(consolidatedTotals.vBC);
            document.getElementById('tot-v-icms').textContent = formatBRL(consolidatedTotals.vICMS);
            document.getElementById('tot-bc-st').textContent = formatBRL(consolidatedTotals.vBCST);
            document.getElementById('tot-v-st').textContent = formatBRL(consolidatedTotals.vST);
            document.getElementById('tot-v-ipi').textContent = formatBRL(consolidatedTotals.vIPI);
            document.getElementById('tot-v-prod').textContent = formatBRL(consolidatedTotals.vProd);
            document.getElementById('tot-v-nf').textContent = formatBRL(consolidatedTotals.vNF);

            // Update included invoices list table
            const invoiceTableBody = document.getElementById('invoice-list-table-body');
            invoiceTableBody.innerHTML = '';
            document.getElementById('invoice-list-count').textContent = filteredInvoices.length;

            filteredInvoices.forEach(inv => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50/50';
                tr.innerHTML = `
                    <td class="py-2 px-2 font-medium text-slate-800">${inv.nNF || '-'} <span class="text-slate-400 font-normal">(${inv.serie || '0'})</span></td>
                    <td class="py-2 px-2 text-slate-600">${inv.dhEmi}</td>
                    <td class="py-2 px-2 text-slate-700 truncate max-w-xs" title="${inv.fornecedor} (${inv.endereco})">${inv.fornecedor} <span class="text-slate-400 text-[11px]">(${inv.endereco})</span></td>
                    <td class="py-2 px-2 text-right font-medium text-slate-800">${formatBRL(inv.totals.vNF)}</td>
                `;
                invoiceTableBody.appendChild(tr);
            });

            // Render NCM Table Body with Checkboxes
            const ncmTableBody = document.getElementById('ncm-table-body');
            ncmTableBody.innerHTML = '';

            const noResultsState = document.getElementById('no-results-state');
            const ncmTableSection = document.getElementById('ncm-table-section');

            if (ncmGroupList.length === 0) {
                ncmTableSection.classList.add('hidden');
                noResultsState.classList.remove('hidden');
            } else {
                noResultsState.classList.add('hidden');
                ncmTableSection.classList.remove('hidden');

                ncmGroupList.forEach((group, index) => {
                    const avgIcms = group.icmsRatesSet.size > 0 ? Array.from(group.icmsRatesSet).reduce((a, b) => a + b, 0) / group.icmsRatesSet.size : 0;
                    const rowId = `ncm-row-${index}`;
                    const isRead = readNcms.has(group.ncm);

                    const mainTr = document.createElement('tr');
                    mainTr.id = rowId;
                    mainTr.className = `border-b border-slate-100 hover:bg-slate-50/80 transition-colors ${isRead ? 'bg-slate-100/60 opacity-60' : ''}`;
                    
                    mainTr.innerHTML = `
                        <td class="py-4 px-4 text-center">
                            <button onclick="toggleNcmAccordion('${rowId}')" class="w-7 h-7 rounded-lg text-slate-400 hover:text-blue-600 hover:bg-blue-50 flex items-center justify-center transition-all">
                                <i class="fa-solid fa-chevron-right text-xs transition-transform duration-200" id="${rowId}-icon"></i>
                            </button>
                        </td>
                        <td class="py-4 px-4 font-semibold text-slate-800 flex items-center gap-3">
                            <input type="checkbox" ${isRead ? 'checked' : ''} onchange="toggleReadNcm('${group.ncm}', '${rowId}')" class="w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500 cursor-pointer" title="Marcar como lido">
                            <span class="${isRead ? 'line-through text-slate-400' : ''}" id="${rowId}-text">${group.ncm}</span>
                        </td>
                        <td class="py-4 px-4 text-right font-medium text-slate-700 ${isRead ? 'line-through text-slate-400' : ''}">${formatBRL(group.totalValue)}</td>
                        <td class="py-4 px-4 text-center text-slate-600 ${isRead ? 'line-through text-slate-400' : ''}">${formatPercent(avgIcms)}</td>
                        <td class="py-4 px-4 text-right font-medium text-slate-700 ${isRead ? 'line-through text-slate-400' : ''}">${formatBRL(group.totalIpiValue)}</td>
                    `;
                    ncmTableBody.appendChild(mainTr);

                    // Sub-table row containing individual product details
                    const subTr = document.createElement('tr');
                    subTr.id = `${rowId}-details`;
                    subTr.className = `hidden bg-slate-50/50 border-b border-slate-100`;
                    
                    let subTableHtml = `
                        <td colspan="5" class="py-3 px-6">
                            <div class="bg-white border border-slate-200/80 rounded-xl p-3 shadow-inner my-2">
                                <p class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Itens detalhados para o NCM: ${group.ncm}</p>
                                <div class="overflow-x-auto max-h-48">
                                    <table class="w-full text-xs text-left">
                                        <thead>
                                            <tr class="text-slate-400 border-b border-slate-100 pb-1">
                                                <th class="py-1.5 px-2">NF</th>
                                                <th class="py-1.5 px-2">Fornecedor</th>
                                                <th class="py-1.5 px-2">Código</th>
                                                <th class="py-1.5 px-2">Descrição do Produto</th>
                                                <th class="py-1.5 px-2 text-right">Qtd</th>
                                                <th class="py-1.5 px-2 text-right">V. Prod</th>
                                                <th class="py-1.5 px-2 text-center">ICMS%</th>
                                                <th class="py-1.5 px-2 text-right">V. IPI</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100 text-slate-700">
                    `;

                    group.items.forEach(item => {
                        subTableHtml += `
                            <tr>
                                <td class="py-1.5 px-2 font-medium">${item.nNF}</td>
                                <td class="py-1.5 px-2 truncate max-w-[120px]" title="${item.fornecedor}">${item.fornecedor}</td>
                                <td class="py-1.5 px-2 font-mono text-slate-500">${item.cProd}</td>
                                <td class="py-1.5 px-2">${item.xProd}</td>
                                <td class="py-1.5 px-2 text-right">${item.qCom} ${item.uCom}</td>
                                <td class="py-1.5 px-2 text-right font-medium">${formatBRL(item.vProd)}</td>
                                <td class="py-1.5 px-2 text-center">${formatPercent(item.pICMS)}</td>
                                <td class="py-1.5 px-2 text-right">${formatBRL(item.vIPI)}</td>
                            </tr>
                        `;
                    });

                    subTableHtml += `
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </td>
                    `;
                    subTr.innerHTML = subTableHtml;
                    ncmTableBody.appendChild(subTr);
                });
            }

            // Update active filter tags display
            const tagContainer = document.getElementById('active-filter-tags');
            tagContainer.innerHTML = '';
            let activeCount = 0;

            if (dateFrom) { addTag(`De: ${dateFrom}`); activeCount++; }
            if (dateTo) { addTag(`Até: ${dateTo}`); activeCount++; }
            if (selectedCity) { addTag(`Local: ${document.getElementById('filter-city').options[document.getElementById('filter-city').selectedIndex].text}`); activeCount++; }
            if (searchVal) { addTag(`Busca: "${searchVal}"`); activeCount++; }
            if (ncmVal) { addTag(`NCM: "${ncmVal}"`); activeCount++; }

            document.getElementById('filter-matches-text').innerHTML = `Exibindo dados de <strong class="text-slate-800">${filteredInvoices.length}</strong> nota(s) fiscal(is) (${totalMatchingItemsCount} itens de NCM).`;
        }

        function addTag(text) {
            const span = document.createElement('span');
            span.className = 'px-2 py-0.5 bg-slate-100 text-slate-600 rounded-md font-medium text-[11px] border border-slate-200 flex items-center gap-1';
            span.innerHTML = `<i class="fa-solid fa-tag text-[9px] text-blue-500"></i> ${text}`;
            document.getElementById('active-filter-tags').appendChild(span);
        }

        function toggleNcmAccordion(rowId) {
            const detailsRow = document.getElementById(`${rowId}-details`);
            const icon = document.getElementById(`${rowId}-icon`);
            if (detailsRow.classList.contains('hidden')) {
                detailsRow.classList.remove('hidden');
                icon.classList.add('rotate-90');
            } else {
                detailsRow.classList.add('hidden');
                icon.classList.remove('rotate-90');
            }
        }

        function toggleReadNcm(ncm, rowId) {
            const mainTr = document.getElementById(rowId);
            const textSpan = document.getElementById(`${rowId}-text`);
            const checkboxes = mainTr.querySelectorAll('input[type="checkbox"]');
            const isChecked = checkboxes[0].checked;

            if (isChecked) {
                readNcms.add(ncm);
                mainTr.classList.add('bg-slate-100/60', 'opacity-60');
                textSpan.classList.add('line-through', 'text-slate-400');
                // Apply line-through to neighbor text cells as well
                mainTr.querySelectorAll('td').forEach((td, idx) => {
                    if (idx > 1) td.classList.add('line-through', 'text-slate-400');
                });
            } else {
                readNcms.delete(ncm);
                mainTr.classList.remove('bg-slate-100/60', 'opacity-60');
                textSpan.classList.remove('line-through', 'text-slate-400');
                mainTr.querySelectorAll('td').forEach((td, idx) => {
                    if (idx > 1) td.classList.remove('line-through', 'text-slate-400');
                });
            }
        }
    </script>
</body>
</html>
